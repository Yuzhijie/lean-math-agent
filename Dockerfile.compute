# Python SymPy compute server
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY scripts/requirements.txt* ./
RUN pip install --no-cache-dir -r requirements.txt 2>/dev/null || pip install --no-cache-dir sympy flask flask-cors

# Copy compute server + the hardened parsing helper it imports
COPY scripts/compute-server.py scripts/safe_parse.py ./
COPY scripts/solve ./solve

# Run as an unprivileged user: the service evaluates untrusted expressions.
RUN useradd --system --uid 1001 compute
USER compute

EXPOSE 8765

# Bind to all interfaces so the `web` container can reach it (the default is
# loopback for local development).
CMD ["python", "compute-server.py", "--host", "0.0.0.0", "--port", "8765"]
