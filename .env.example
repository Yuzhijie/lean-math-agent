LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LEAN_SANDBOX_PATH=lean-sandbox
# Per-verification timeout in ms (REPL command / `lake env lean` run)
LEAN_BUILD_TIMEOUT_MS=120000
# Max concurrent `lake env lean` processes in spawn mode (1–4)
LEAN_LAKE_CONCURRENCY=1

# ── Lean verification backend ───────────────────────────────
# "server" (default): persistent leanprover-community/repl workers — Mathlib is
#   imported once per worker and reused; results include sorry goals; the
#   target theorem gets `#print axioms` / `#check` probes.
#   Build once:  cd lean-sandbox && lake build repl
# "spawn": run `lake env lean <file>` per verification (slow fallback; also
#   used automatically when the REPL binary is missing or crashes).
LEAN_SERVER_MODE=server
# Timeout for the first `import Mathlib` in a worker (ms; default 180000)
LEAN_SERVER_STARTUP_MS=180000
# Kill idle REPL workers after N ms of inactivity (default 300000)
LEAN_SERVER_IDLE_TIMEOUT_MS=300000
# Number of REPL worker processes (default 1; each imports Mathlib — count
# roughly 1–2 GB of resident memory per worker)
LEAN_REPL_WORKERS=1
# Recycle a worker after this many commands to bound memory growth (default 100)
LEAN_REPL_MAX_USES=100
# Path to the REPL binary (default: lean-sandbox/.lake/packages/repl/.lake/build/bin/repl)
# LEAN_REPL_BIN=
# Full launch command instead of `lake env <bin>` (containers with LEAN_PATH preset, tests)
# LEAN_REPL_COMMAND=
# Accept proofs that use native_decide (trusts the compiler, not the kernel). Default: false
LEAN_ALLOW_NATIVE_DECIDE=false
# SymPy compute server (required for computational problems)
# Start with: python scripts/compute-server.py --port 5001
COMPUTE_ENGINE_URL=http://localhost:5001
SESSION_STORE_PATH=.data/sessions

# ── OpenAI reasoning models (GPT-5.x / GPT-6 / o-series) ──────
# Example: GPT-5.6 Luna as the only model
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-5.6-luna
#   LLM_REASONING_EFFORT=medium
#   LLM_TIMEOUT_MS=300000
#   LLM_PRICES={"gpt-5.6-luna":{"input":0.2,"output":1.2}}
# The client detects these models by name and speaks their dialect: no
# temperature/top_p (they are rejected unless reasoning is "none"),
# `max_completion_tokens` instead of `max_tokens`, `reasoning_effort` when set.
# Reasoning effort for every call: none | minimal | low | medium | high | xhigh | max
# (unset = the API default). Per-role overrides: LLM_PROVER_REASONING_EFFORT,
# LLM_PLANNER_REASONING_EFFORT (e.g. prover high, everything else low).
# LLM_REASONING_EFFORT=medium
# LLM_PROVER_REASONING_EFFORT=high
# Extra completion tokens reserved for hidden reasoning when a cap is set (default 16384)
# LLM_REASONING_TOKEN_BUDGET=16384
# Same model through OpenRouter (https://openrouter.ai — key sk-or-v1-…):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-5.6-luna
#   LLM_REASONING_EFFORT=medium
#   LLM_PRICES={"openai/gpt-5.6-luna":{"input":0.2,"output":1.2}}
# On openrouter.ai the effort is sent as OpenRouter's `reasoning: { effort }`
# object and the cap as `max_tokens` (OpenRouter translates for OpenAI).
# Overrides for providers that differ: send temperature/top_p auto|always|never;
# completion cap field auto|max_tokens|max_completion_tokens; reasoning field
# auto|reasoning_effort|reasoning
# LLM_SAMPLING_PARAMS=auto
# LLM_MAX_TOKENS_PARAM=auto
# LLM_REASONING_PARAM=auto

# ── Model roles (optional) ─────────────────────────────────
# Each LLM call carries a role. "prover" writes Lean proofs (whole-proof
# sampling + step candidates), "planner" formalizes/enumerates/plans/scores,
# "general" is everything else. A role without its own model uses the
# general chain. Point the prover at a Lean-specialised open model served
# with an OpenAI-compatible API (vLLM/SGLang/Ollama/OpenRouter), e.g.
# Goedel-Prover-V2-8B/32B, Kimina-Prover-72B, DeepSeek-Prover-V2-7B.
# LLM_PROVER_MODEL=Goedel-LM/Goedel-Prover-V2-8B
# LLM_PROVER_BASE_URL=http://localhost:8000/v1
# LLM_PROVER_API_KEY=
# Try the general chain when every prover endpoint fails (default: true)
# LLM_PROVER_FALLBACK_TO_GENERAL=true
# Also use the dedicated prover for the stepwise JSON calls (default: false —
# specialised provers write whole proofs well but JSON badly)
# LLM_PROVER_STEPWISE=false
# LLM_PLANNER_MODEL=
# LLM_PLANNER_BASE_URL=
# LLM_PLANNER_API_KEY=
# Prices per 1M tokens, for the cost estimate in the run metrics
# LLM_PRICES={"gpt-4.1":{"input":2,"output":8},"Goedel-LM/Goedel-Prover-V2-8B":{"input":0,"output":0}}

# ── Whole-proof prover loop ────────────────────────────────
# Before the stepwise pipeline, sample complete proofs from the prover,
# verify them all, and repair the best failure with Lean's errors, open
# goals and `exact?`/`apply?`/`simp?` suggestions (default: on).
# WHOLE_PROOF_ENABLED=true
# Proofs sampled per round / repair rounds after the first / temperature
# WHOLE_PROOF_SAMPLES=4
# WHOLE_PROOF_ROUNDS=2
# WHOLE_PROOF_TEMPERATURE=0.8
# WHOLE_PROOF_MAX_TOKENS=4096
# Wall-clock budget for the loop (ms)
# WHOLE_PROOF_BUDGET_MS=180000
# Run library-search probes on the best failure before repairing
# WHOLE_PROOF_SUGGEST=true
# Budget for the exact?/apply?/simp? probes (ms)
# LEAN_SUGGEST_TIMEOUT_MS=60000
# Optional Loogle instance for resolving unknown lemma names
# (public: https://loogle.lean-lang.org — mind its rate limits)
# LOOGLE_URL=

# ── Formal-proof reinforcement (Phase 2b) ──────────────────
# Proof budget preset scaling whole-proof samples/rounds, sketch and
# goal-search limits together: low | normal | high (per-request
# `options.budget` overrides). Explicit stage settings below still win.
# PROOF_BUDGET=normal
# Per-tactic timeout in REPL tactic mode (ms)
# LEAN_TACTIC_TIMEOUT_MS=60000
# Automation hammer (rfl/decide/simp/omega/norm_num/linarith/nlinarith/
# positivity/aesop/exact? cascade on the root goal and every search node)
# LEAN_HAMMER_BUDGET_MS=30000
# Goal-level best-first search (REPL tactic mode): tactics sampled per
# node, node/depth caps, frontier size, wall-clock budget, temperature
# GOAL_SEARCH_SAMPLES=4
# GOAL_SEARCH_MAX_NODES=60
# GOAL_SEARCH_MAX_DEPTH=20
# GOAL_SEARCH_BEAM=16
# GOAL_SEARCH_BUDGET_MS=120000
# GOAL_SEARCH_TEMPERATURE=0.8
# GOAL_SEARCH_HAMMER=true
# Retrieve premises for the current goal at every node
# GOAL_SEARCH_RETRIEVE=true
# Sketch-and-fill (proof skeleton with `have … := by sorry` holes, each hole
# closed by the hammer / goal search): on/off, sketches per round, repair
# rounds, max holes, stage budget, per-hole budget (ms)
# SKETCH_ENABLED=true
# SKETCH_SAMPLES=2
# SKETCH_REPAIRS=1
# SKETCH_MAX_HOLES=8
# SKETCH_BUDGET_MS=300000
# SKETCH_HOLE_BUDGET_MS=60000
# Premise retrieval (BM25 over Mathlib lemma names/statements; a curated
# seed of ~700 lemmas is built in — `npm run premises:build` adds the
# sandbox's Mathlib) and how many lemmas the prompts get
# PREMISES_ENABLED=true
# PREMISE_INDEX_PATH=.data/premise-index.json
# PREMISES_TOP_K=8
# Proof memory: verified proofs are stored and similar ones are shown to
# the prover as worked examples
# PROOF_MEMORY_ENABLED=true
# PROOF_MEMORY_PATH=.data/proof-memory.json
# PROOF_MEMORY_MAX=2000
# PROOF_MEMORY_TOP_K=2
# Autoformalization reliability: formalizations sampled per attempt (the
# statement most candidates agree on wins) and counterexample search on
# the chosen statement (`decide` on the negation, Mathlib `plausible`
# random testing) before any proof search
# AUTOFORMALIZE_CANDIDATES=1
# REFUTE_ENABLED=true
# REFUTE_TIMEOUT_MS=20000
# REFUTE_TRIALS=200

# ── Stepwise search ────────────────────────────────────────
# Candidates sampled per step (verified in parallel), beam width, expansion cap
# PROOF_SEARCH_SAMPLES=2
# PROOF_SEARCH_BEAM=5
# PROOF_SEARCH_MAX_EXPANSIONS=40
# Enumerate methods with the multi-agent strategists + critic in /api/solve
# SOLVE_MULTI_AGENT=false

# ── Model Fallback (optional) ──────────────────────────────
# Comma-separated list of fallback models tried after primary fails
# LLM_FALLBACK_MODELS=gpt-4o-mini,gpt-4o
# Optional: different base URL / API key for fallback models
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=

# ── HTTP Retry ──────────────────────────────────────────────
# Max retries per endpoint for 429/5xx errors (default: 3)
# LLM_MAX_HTTP_RETRIES=3
# Base delay for exponential backoff in ms (default: 500)
# LLM_BASE_RETRY_DELAY_MS=500

# ── Response Cache (optional) ──────────────────────────────
# Enable in-memory LRU cache for identical prompts
# LLM_CACHE_ENABLED=false
# LLM_CACHE_MAX_SIZE=100

# ── Logging ─────────────────────────────────────────────────
# Log level: silent | error | info | debug (default: error)
# LLM_LOG_LEVEL=error

# ── Advanced ────────────────────────────────────────────────
# Per-request timeout in ms (default: 120000)
# LLM_TIMEOUT_MS=120000
# Disable response_format: json_object (some providers don't support it)
# LLM_JSON_MODE=true
# Enable thinking mode for thinking-capable models (default: false)
# LLM_ENABLE_THINKING=false

# ═══════════════════════════════════════════════════════════════
# P3 Features — Authentication, Payments, Knowledge Graph
# ═══════════════════════════════════════════════════════════════

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# OAuth providers (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ── Database (Prisma) ──────────────────────────────────────
DATABASE_URL=file:.data/prod.db

# ── Stripe Payments ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Neo4j Knowledge Graph ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Clingo (Geometry Solver) ──────────────────────────────
# Install: brew install clingo (macOS) or apt install clingo (Linux)
CLINGO_PATH=clingo
