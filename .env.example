LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LEAN_SANDBOX_PATH=lean-sandbox
LEAN_BUILD_TIMEOUT_MS=120000
LEAN_MATHLIB_CACHE_PATH=
LEAN_LAKE_CONCURRENCY=1
# Lean server mode: "server" (default, persistent process) or "spawn" (fallback)
LEAN_SERVER_MODE=server
# Server startup timeout in ms (default: 30000)
LEAN_SERVER_STARTUP_MS=30000
# Server idle timeout — auto-kill after N ms of inactivity (default: 300000)
LEAN_SERVER_IDLE_TIMEOUT_MS=300000
# SymPy compute server (required for computational problems)
# Start with: python scripts/compute-server.py --port 5001
COMPUTE_ENGINE_URL=http://localhost:5001
SESSION_STORE_PATH=.data/sessions

# ── Model Fallback (optional) ──────────────────────────────
# Comma-separated list of fallback models tried after primary fails
# LLM_FALLBACK_MODELS=gpt-4o-mini,gpt-4o
# Optional: different base URL / API key for fallback models
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=

# ── HTTP Retry ──────────────────────────────────────────────
# Max retries per endpoint for 429/5xx errors (default: 3)
# LLM_MAX_HTTP_RETRIES=3
# Base delay for exponential backoff in ms (default: 500)
# LLM_BASE_RETRY_DELAY_MS=500

# ── Response Cache (optional) ──────────────────────────────
# Enable in-memory LRU cache for identical prompts
# LLM_CACHE_ENABLED=false
# LLM_CACHE_MAX_SIZE=100

# ── Logging ─────────────────────────────────────────────────
# Log level: silent | error | info | debug (default: error)
# LLM_LOG_LEVEL=error

# ── Advanced ────────────────────────────────────────────────
# Per-request timeout in ms (default: 120000)
# LLM_TIMEOUT_MS=120000
# Disable response_format: json_object (some providers don't support it)
# LLM_JSON_MODE=true
# Enable thinking mode for thinking-capable models (default: false)
# LLM_ENABLE_THINKING=false

# ═══════════════════════════════════════════════════════════════
# P3 Features — Authentication, Payments, Knowledge Graph
# ═══════════════════════════════════════════════════════════════

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# OAuth providers (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ── Database (Prisma) ──────────────────────────────────────
DATABASE_URL=file:.data/prod.db

# ── Stripe Payments ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Neo4j Knowledge Graph ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Clingo (Geometry Solver) ──────────────────────────────
# Install: brew install clingo (macOS) or apt install clingo (Linux)
CLINGO_PATH=clingo
