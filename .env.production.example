# Invite-only beta — copy to .env.production (never commit it) and fill in.
# docker-compose.yml sets NODE_ENV, AUTH_REQUIRED, paths and internal URLs itself.
# The server refuses to start when something required is missing (lib/startup-checks.ts);
# check with: curl https://<your-domain>/api/health

# ── Public address and sign-in ───────────────────────────────────────
NEXTAUTH_URL=https://math.example.com
# openssl rand -base64 32
NEXTAUTH_SECRET=
# At least one provider. Callback URLs: https://<domain>/api/auth/callback/github | /google
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ── Who may sign in ──────────────────────────────────────────────────
# Comma-separated. More can be added any time, without a restart, as lines in the volume's
# /app/data/invites.txt (one email, or @domain for everyone at a domain):
#   docker compose exec web sh -c 'echo teacher@school.org >> /app/data/invites.txt'
INVITE_EMAILS=
INVITE_DOMAINS=

# ── Models (every model any role can call must have a price) ────────
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna
# USD per million tokens
LLM_PRICES={"openai/gpt-5.6-luna":{"input":0.2,"output":1.2}}
# Optional roles (add their models to LLM_PRICES too):
# LLM_PROVER_MODEL=
# LLM_VISION_MODEL=

# ── Spend limits (USD) ───────────────────────────────────────────────
# Per user per day (beta users are on the free plan unless they subscribe)
QUOTA_DAILY_USD_FREE=1
# Per solve
PROOF_COST_CAP_USD=0.5
PROOF_BUDGET=low
RATE_LIMIT_PER_MIN=6
RATE_LIMIT_CALLS_PER_MIN=30

# ── Capacity (one server; Lean workers take ~1.5–2 GB each) ─────────
SOLVE_CONCURRENCY=2
LEAN_REPL_WORKERS=2

# ── Payments (leave empty during the beta) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
