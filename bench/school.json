{
  "name": "school-v1",
  "description": "小学和初中各类题型的陈述（按形式化会写出的样子），每条记着不调模型的流程里由哪条路线证出。`npm run lean:regress -- --file bench/school.json --out bench/SCHOOL.md`。for = 学段/题型。",
  "cases": [
    {"id":"p-calc-distributive","name":"p_calc_distributive","type":": (36 : ℕ) * 24 + 36 * 76 = 3600","for":"primary/计算","about":"简便运算：36×24 + 36×76 = 3600","source":"probe","expect":"hammer"},
    {"id":"p-calc-decimal","name":"p_calc_decimal","type":": (3.6 : ℝ) * 2.5 + 1.25 * 8 = 19","for":"primary/计算","about":"小数乘法：3.6×2.5 + 1.25×8 = 19","source":"probe","expect":"hammer"},
    {"id":"p-calc-fraction","name":"p_calc_fraction","type":": (2 / 3 : ℚ) + 3 / 4 - 5 / 6 = 7 / 12","for":"primary/计算","about":"分数加减：2/3 + 3/4 − 5/6 = 7/12","source":"probe","expect":"hammer"},
    {"id":"p-calc-mixed","name":"p_calc_mixed","type":": ((125 : ℚ) - 25 * 3) / (4 + 6) * (1 / 2) + 7 / 2 = 6","for":"primary/计算","about":"带括号的四则混合运算","source":"probe","expect":"hammer"},
    {"id":"p-frac-compare","name":"p_frac_compare","type":": (5 / 7 : ℚ) < 8 / 11","for":"primary/计算","about":"分数比较大小：5/7 < 8/11","source":"probe","expect":"hammer"},
    {"id":"p-percent","name":"p_percent","type":"(x : ℝ) (h : x = 240 * (1 - 25 / 100)) : x = 180","for":"primary/百分数","about":"打七五折：240 元的 75% 是 180 元","source":"probe","expect":"hammer"},
    {"id":"p-profit","name":"p_profit","type":"(c : ℝ) (h : c * (1 + 40 / 100) * (80 / 100) = c + 24) : c = 200","for":"primary/百分数","about":"成本 c，加价 40% 后打八折，获利 24 元 ⇒ c = 200","source":"probe","expect":"hammer"},
    {"id":"p-concentration","name":"p_concentration","type":"(x : ℝ) (hx : 0 ≤ x) (h : (200 * (10 / 100) + x) / (200 + x) = 20 / 100) : x = 25","for":"primary/百分数","about":"200 克 10% 的盐水加盐 x 克变成 20% ⇒ x = 25","source":"probe","expect":"auto"},
    {"id":"p-divmod","name":"p_divmod","type":": 2025 / 7 = 289 ∧ 2025 % 7 = 2","for":"primary/数论","about":"带余除法：2025 ÷ 7 = 289 余 2","source":"probe","expect":"hammer"},
    {"id":"p-gcd-lcm","name":"p_gcd_lcm","type":": Nat.gcd 84 126 = 42 ∧ Nat.lcm 84 126 = 252","for":"primary/数论","about":"84 和 126 的最大公因数 42、最小公倍数 252","source":"probe","expect":"hammer"},
    {"id":"p-divisors","name":"p_divisors","type":": (Nat.divisors 360).card = 24","for":"primary/数论","about":"360 有 24 个因数","source":"probe","expect":"hammer"},
    {"id":"p-primes-100","name":"p_primes_100","type":": ((Finset.range 101).filter Nat.Prime).card = 25","for":"primary/数论","about":"100 以内有 25 个质数","source":"probe","expect":"hammer"},
    {"id":"p-factorize","name":"p_factorize","type":": (360 : ℕ) = 2 ^ 3 * 3 ^ 2 * 5 ∧ Nat.Prime 2 ∧ Nat.Prime 3 ∧ Nat.Prime 5","for":"primary/数论","about":"分解质因数：360 = 2³ × 3² × 5","source":"probe","expect":"hammer"},
    {"id":"p-last-digit","name":"p_last_digit","type":": 7 ^ 2025 % 10 = 7","for":"primary/数论","about":"周期问题：7^2025 的个位数字是 7","source":"probe","expect":"hammer"},
    {"id":"p-multiples","name":"p_multiples","type":": ((Finset.Icc 1 100).filter (fun n => 3 ∣ n ∨ 5 ∣ n)).card = 47","for":"primary/数论","about":"1 到 100 中 3 或 5 的倍数有 47 个","source":"probe","expect":"hammer"},
    {"id":"p-remainder","name":"p_remainder","type":": (23 % 3 = 2 ∧ 23 % 5 = 3 ∧ 23 % 7 = 2) ∧ ∀ n : ℕ, 0 < n → n % 3 = 2 → n % 5 = 3 → n % 7 = 2 → 23 ≤ n","for":"primary/数论","about":"除以 3 余 2、除以 5 余 3、除以 7 余 2 的最小正整数是 23（韩信点兵）","source":"probe","expect":"hammer"},
    {"id":"p-chicken-rabbit","name":"p_chicken_rabbit","type":"(c r : ℕ) (h1 : c + r = 35) (h2 : 2 * c + 4 * r = 94) : c = 23 ∧ r = 12","for":"primary/应用题","about":"鸡兔同笼：35 个头 94 只脚 ⇒ 鸡 23、兔 12","source":"probe","expect":"hammer"},
    {"id":"p-sum-multiple","name":"p_sum_multiple","type":"(a b : ℕ) (h1 : a + b = 120) (h2 : a = 3 * b) : a = 90 ∧ b = 30","for":"primary/应用题","about":"和倍问题：和 120，甲是乙的 3 倍","source":"probe","expect":"hammer"},
