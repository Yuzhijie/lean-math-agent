    {"id":"p-max-area","name":"p_max_area","type":"(l w : ℝ) (h : l + w = 10) : l * w ≤ 25","for":"primary/图形","about":"周长一定的长方形，正方形面积最大：l + w = 10 ⇒ lw ≤ 25","source":"probe","expect":"hammer"},
