    {"id":"p-circle","name":"p_circle","type":"(r : ℝ) (h : 2 * Real.pi * r = 12 * Real.pi) : Real.pi * r ^ 2 = 36 * Real.pi","for":"primary/图形","about":"圆周长 12π ⇒ 面积 36π","source":"probe","expect":"auto"},
