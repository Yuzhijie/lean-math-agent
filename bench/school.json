    {"id":"p-three-digit","name":"p_three_digit","type":": ((Finset.Icc 100 999).filter (fun n => n / 100 ≤ 4 ∧ n / 10 % 10 ≤ 4 ∧ n % 10 ≤ 4 ∧ n / 100 ≠ n / 10 % 10 ∧ n / 100 ≠ n % 10 ∧ n / 10 % 10 ≠ n % 10)).card = 48","for":"primary/计数","about":"用 0–4 组成没有重复数字的三位数有 48 个","source":"probe","expect":"hammer"},
