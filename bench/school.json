    {"id":"m-midline","name":"m_midline","type":"(A B C : ℝ × ℝ) : let M : ℝ × ℝ := ((A.1 + B.1) / 2, (A.2 + B.2) / 2); let N : ℝ × ℝ := ((A.1 + C.1) / 2, (A.2 + C.2) / 2); (N.1 - M.1, N.2 - M.2) = ((C.1 - B.1) / 2, (C.2 - B.2) / 2)","for":"middle/几何证明","about":"三角形中位线平行于第三边且等于它的一半（坐标）","source":"probe","expect":"hammer"},
    {"id":"m-median-hypotenuse","name":"m_median_hypotenuse","type":"(a b : ℝ) : let M : ℝ × ℝ := (a / 2, b / 2); Real.sqrt ((M.1 - 0) ^ 2 + (M.2 - 0) ^ 2) = Real.sqrt ((a - 0) ^ 2 + (0 - b) ^ 2) / 2","for":"middle/几何证明","about":"直角三角形斜边上的中线等于斜边的一半（坐标）","source":"probe","expect":"geometry"},
    {"id":"m-parallelogram","name":"m_parallelogram","type":"(A B C D : ℝ × ℝ) (h : (B.1 - A.1, B.2 - A.2) = (C.1 - D.1, C.2 - D.2)) : ((A.1 + C.1) / 2, (A.2 + C.2) / 2) = ((B.1 + D.1) / 2, (B.2 + D.2) / 2)","for":"middle/几何证明","about":"平行四边形的对角线互相平分（坐标）","source":"probe","expect":"geometry"},
    {"id":"m-isosceles","name":"m_isosceles","type":"(A B C : ℝ × ℝ) (h : (A.1 - B.1) ^ 2 + (A.2 - B.2) ^ 2 = (A.1 - C.1) ^ 2 + (A.2 - C.2) ^ 2) : let M : ℝ × ℝ := ((B.1 + C.1) / 2, (B.2 + C.2) / 2); (A.1 - M.1) * (C.1 - B.1) + (A.2 - M.2) * (C.2 - B.2) = 0","for":"middle/几何证明","about":"等腰三角形底边上的中线垂直于底边（坐标）","source":"probe","expect":"geometry"},
