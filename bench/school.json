    {"id":"p-age","name":"p_age","type":"(f s : ℕ) (h1 : f = 4 * s) (h2 : f + 20 = 2 * (s + 20)) : f = 40 ∧ s = 10","for":"primary/应用题","about":"年龄问题：父亲是儿子的 4 倍，20 年后是 2 倍","source":"probe","expect":"hammer"},
    {"id":"p-meeting","name":"p_meeting","type":"(t : ℝ) (h : 60 * t + 80 * t = 420) : t = 3","for":"primary/应用题","about":"相遇问题：相距 420 千米，速度 60 和 80 ⇒ 3 小时","source":"probe","expect":"hammer"},
    {"id":"p-chase","name":"p_chase","type":"(t : ℝ) (h : 75 * t = 60 * t + 60 * 2) : t = 8","for":"primary/应用题","about":"追及问题：先走 2 小时，速度 60 和 75 ⇒ 8 小时追上","source":"probe","expect":"hammer"},
    {"id":"p-work","name":"p_work","type":"(t : ℝ) (h : t * (1 / 12 + 1 / 18) = 1) : t = 36 / 5","for":"primary/应用题","about":"工程问题：甲 12 天、乙 18 天，合作 36/5 天","source":"probe","expect":"hammer"},
    {"id":"p-surplus","name":"p_surplus","type":"(n m : ℕ) (h1 : m = 5 * n + 12) (h2 : m + 8 = 7 * n) : n = 10 ∧ m = 62","for":"primary/应用题","about":"盈亏问题：每人 5 个多 12 个，每人 7 个少 8 个 ⇒ 10 人 62 个","source":"probe","expect":"hammer"},
    {"id":"p-trees","name":"p_trees","type":": (100 : ℕ) / 5 + 1 = 21","for":"primary/应用题","about":"植树问题：100 米每 5 米一棵，两端都种 ⇒ 21 棵","source":"probe","expect":"hammer"},
    {"id":"p-ratio","name":"p_ratio","type":"(a b c : ℝ) (h1 : a + b + c = 180) (h2 : b = 3 / 2 * a) (h3 : c = 2 * a) : a = 40 ∧ b = 60 ∧ c = 80","for":"primary/应用题","about":"按比分配：三个角的比 2:3:4，和 180°","source":"probe","expect":"auto"},
    {"id":"p-average","name":"p_average","type":": ((85 : ℚ) + 92 + 78 + 90 + 95) / 5 = 88","for":"primary/统计","about":"五次成绩的平均数是 88","source":"probe","expect":"hammer"},
    {"id":"p-series-100","name":"p_series_100","type":": ∑ i ∈ Finset.range 100, (i + 1) = 5050","for":"primary/数列","about":"1 + 2 + … + 100 = 5050","source":"probe","expect":"hammer"},
    {"id":"p-series-odd","name":"p_series_odd","type":": ∑ i ∈ Finset.Icc 1 50, (2 * i - 1) = 2500","for":"primary/数列","about":"前 50 个奇数的和是 2500","source":"probe","expect":"hammer"},
    {"id":"p-sequence-term","name":"p_sequence_term","type":"(a : ℕ → ℤ) (h1 : a 1 = 3) (h : ∀ n, a (n + 1) = a n + 4) : a 10 = 39","for":"primary/数列","about":"等差数列：首项 3、公差 4，第 10 项是 39","source":"probe","expect":"hammer"},
    {"id":"p-new-operation","name":"p_new_operation","type":": let op : ℕ → ℕ → ℕ := fun a b => 3 * a + 2 * b; op (op 1 2) 3 = 27","for":"primary/计算","about":"定义新运算 a※b = 3a + 2b，(1※2)※3 = 27","source":"probe","expect":"hammer"},
    {"id":"p-digits","name":"p_digits","type":"(a b : ℕ) (ha : 1 ≤ a ∧ a ≤ 9) (hb : b ≤ 9) (h : 10 * a + b + (10 * b + a) = 121) : a + b = 11","for":"primary/数论","about":"两位数与它的倒序数之和是 121 ⇒ 数字和 11","source":"probe","expect":"hammer"},
    {"id":"p-rect","name":"p_rect","type":"(l w : ℝ) (h1 : 2 * (l + w) = 36) (h2 : l = 2 * w) : l * w = 72","for":"primary/图形","about":"长方形周长 36，长是宽的 2 倍 ⇒ 面积 72","source":"probe","expect":"hammer"},
